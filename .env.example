# MongoDB Atlas credentials
USER=
PASSWORD=
# Secret used to sign JWTs
SECRET_KEY=
# Comma-separated emails that become admins automatically on first login
# (e.g. ADMIN_EMAILS=owner@example.com,admin@example.com)
ADMIN_EMAILS=
# Port the server listens on (default 5000)
PORT=5000
# Set to "production" for secure, cross-site auth cookies
NODE_ENV=development
